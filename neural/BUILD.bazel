load("@rules_python//python:defs.bzl", "py_binary")
load(":gpu_runtime.bzl", "gpu_runtime")

exports_files(["Cargo.toml", "Cargo.lock", "src/main.rs"], visibility = ["//visibility:public"])

py_binary(
    name = "bundle-gpu",
    srcs = ["bundle-gpu.py"],
    main = "bundle-gpu.py",
)

gpu_runtime(
    name = "cuda-runtime",
    srcs = [
        "gpu-worker.py",
        "inference.py",
        "rescorer.py",
        "backends.py",
        "decoding_model.py",
        "decoder.py",
        "byte_constraints.py",
        "token_bytes.py",
        "text_decoder.py",
        "prefix_cache.py",
        "conditional_prefix.py",
        "request_cache.py",
        "branch_cache.py",
        "native_llama.py",
        "native_rescorer.py",
        "japanese.py",
        "conditional.py",
        "context-pinyin.json",
        "requirements-gpu.txt",
        "//third_party/chinese-ime-lm:LICENSE",
        "//third_party/chinese-ime-lm/neural:model.py",
    ],
    visibility = ["//wdoom/bazel/native:__pkg__"],
)

# Keep the optional CPU worker's Cargo graph out of CUDA runtime packaging.
alias(
    name = "wime-neural",
    actual = "//emacs-packages/wime/neural/rust:wime-neural",
    visibility = ["//visibility:public"],
)
