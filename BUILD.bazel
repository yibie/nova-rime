load("@rules_cc//cc:cc_binary.bzl", "cc_binary")
load("@rules_python//python:defs.bzl", "py_binary")

package(default_visibility = ["//visibility:private"])

cc_binary(
    name = "librime-grammar.so",
    srcs = ["grammar.cc"],
    copts = [
        "-fPIC",
        "-O2",
        "-std=c++17",
        "-DGLOG_USE_GLOG_EXPORT",
        "-I/usr/local/include",
    ],
    linkopts = [
        "-L/usr/lib/rime-plugins",
        "-l:librime-octagram.so",
        "-Wl,-rpath,/usr/lib/rime-plugins",
    ],
    linkshared = True,
    linkstatic = True,
    visibility = ["//wdoom/bazel/native:__pkg__"],
    deps = [
        "//third_party/librime-octagram:octagram",
        "//third_party/librime:rime",
        "@rime_system_deps//:deps",
    ],
)

py_binary(
    name = "generator",
    srcs = ["gen/wime_gen.py"],
    main = "gen/wime_gen.py",
)

genrule(
    name = "database",
    srcs = [
        "@rime_wanxiang//:sources",
        "@rime_wanxiang//:wanxiang_algebra.yaml",
        "@rime_wanxiang//:wanxiang_pro.dict.yaml",
    ],
    outs = ["wanxiang.db"],
    cmd = "RIME=$$(dirname $(location @rime_wanxiang//:wanxiang_pro.dict.yaml)); " +
          "$(location :generator) --rime-data $$RIME --database $@",
    tools = [":generator"],
    visibility = ["//wdoom/bazel/native:__pkg__"],
)

# 量体双拼, the layout keyboard-ergonomics/optimize.py fitted to measured typing
# costs ("prefer L/R"); try it with M-x wime-select-database.
genrule(
    name = "database_liangti",
    srcs = [
        "schemes/liangti.json",
        "@rime_wanxiang//:sources",
        "@rime_wanxiang//:wanxiang_pro.dict.yaml",
    ],
    outs = ["wanxiang-liangti.db"],
    cmd = "RIME=$$(dirname $(location @rime_wanxiang//:wanxiang_pro.dict.yaml)); " +
          "$(location :generator) --rime-data $$RIME --database $@ " +
          "--scheme $(location schemes/liangti.json)",
    tools = [":generator"],
    visibility = ["//wdoom/bazel/native:__pkg__"],
)

# 量体双拼·速: the same measurements optimised without memorability rules.
genrule(
    name = "database_liangti_fast",
    srcs = [
        "schemes/liangti-fast.json",
        "@rime_wanxiang//:sources",
        "@rime_wanxiang//:wanxiang_pro.dict.yaml",
    ],
    outs = ["wanxiang-liangti-fast.db"],
    cmd = "RIME=$$(dirname $(location @rime_wanxiang//:wanxiang_pro.dict.yaml)); " +
          "$(location :generator) --rime-data $$RIME --database $@ " +
          "--scheme $(location schemes/liangti-fast.json)",
    tools = [":generator"],
    visibility = ["//wdoom/bazel/native:__pkg__"],
)
