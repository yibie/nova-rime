load("@rules_cc//cc:cc_binary.bzl", "cc_binary")
load("@rules_python//python:defs.bzl", "py_binary")

package(default_visibility = ["//visibility:private"])

cc_binary(
    name = "librime-grammar.so",
    srcs = ["grammar.cc"],
    copts = [
        "-fPIC",
        "-O2",
        "-std=c++17",
        "-DGLOG_USE_GLOG_EXPORT",
        "-I/usr/local/include",
    ],
    linkopts = [
        "-L/usr/lib/rime-plugins",
        "-l:librime-octagram.so",
        "-Wl,-rpath,/usr/lib/rime-plugins",
    ],
    linkshared = True,
    linkstatic = True,
    visibility = ["//wdoom/bazel/native:__pkg__"],
    deps = [
        "//third_party/librime-octagram:octagram",
        "//third_party/librime:rime",
        "@rime_system_deps//:deps",
    ],
)

exports_files(["gen/wime_gen.py"], visibility = ["//emacs-packages/wime/neural:__pkg__"])

py_binary(
    name = "generator",
    srcs = ["gen/wime_gen.py"],
    data = [
        "schemes/mspy.json",
        "//emacs-packages/wime/neural:context-pinyin.json",
    ],
    main = "gen/wime_gen.py",
)

genrule(
    name = "database",
    srcs = [
        "schemes/mspy.json",
        "@rime_wanxiang//:sources",
        "@rime_wanxiang//:wanxiang_pro.dict.yaml",
    ],
    outs = ["wanxiang.db"],
    cmd = "RIME=$$(dirname $(location @rime_wanxiang//:wanxiang_pro.dict.yaml)); " +
          "$(location :generator) --rime-data $$RIME --database $@ " +
          "--scheme $(location schemes/mspy.json)",
    tools = [":generator"],
    visibility = ["//wdoom/bazel/native:__pkg__"],
)

genrule(
    name = "database_ziranma",
    srcs = [
        "schemes/ziranma.json",
        "@rime_wanxiang//:sources",
        "@rime_wanxiang//:wanxiang_pro.dict.yaml",
    ],
    outs = ["wanxiang-ziranma.db"],
    cmd = "RIME=$$(dirname $(location @rime_wanxiang//:wanxiang_pro.dict.yaml)); " +
          "$(location :generator) --rime-data $$RIME --database $@ " +
          "--scheme $(location schemes/ziranma.json)",
    tools = [":generator"],
    visibility = ["//wdoom/bazel/native:__pkg__"],
)

genrule(
    name = "database_flypy",
    srcs = [
        "schemes/flypy.json",
        "@rime_wanxiang//:sources",
        "@rime_wanxiang//:wanxiang_pro.dict.yaml",
    ],
    outs = ["wanxiang-flypy.db"],
    cmd = "RIME=$$(dirname $(location @rime_wanxiang//:wanxiang_pro.dict.yaml)); " +
          "$(location :generator) --rime-data $$RIME --database $@ " +
          "--scheme $(location schemes/flypy.json)",
    tools = [":generator"],
    visibility = ["//wdoom/bazel/native:__pkg__"],
)

genrule(
    name = "database_sogou",
    srcs = [
        "schemes/sogou.json",
        "@rime_wanxiang//:sources",
        "@rime_wanxiang//:wanxiang_pro.dict.yaml",
    ],
    outs = ["wanxiang-sogou.db"],
    cmd = "RIME=$$(dirname $(location @rime_wanxiang//:wanxiang_pro.dict.yaml)); " +
          "$(location :generator) --rime-data $$RIME --database $@ " +
          "--scheme $(location schemes/sogou.json)",
    tools = [":generator"],
    visibility = ["//wdoom/bazel/native:__pkg__"],
)

filegroup(
    name = "databases",
    srcs = [
        ":database",
        ":database_flypy",
        ":database_sogou",
        ":database_ziranma",
    ],
)
