  "current_qwen_path": {
    "confirmed": "Runtime fallback warning plus CPU inspection of all four decorator closures: reference implementations and is_new_implementation=False.",
    "dispatch": "Cached seq_len==1 selects recurrent/update; other calls select chunk. The reference chunk casts to FP32, pads to multiples of64, and invokes two triangular solves.",
    "availability": "Current FLA dependency declarations admit torch2.11/triton3.6; operational compatibility remains untested. causal-conv1d1.7.0 assets have no matching torch2.11 wheel; nvcc is present, so source build is possible but untested.",
    "hardware_limit": "Qwen FlashQLA support list includes SM90/100/103/120/121, not this SM89 GPU.",
    "next_ablation": [
      "existing fallback",
      "FLA only",
      "causal-conv1d only",
      "both"
    ],
    "next_dispatch_experiment": "After fused kernels are actually resolved, sweep cached suffix lengths1/2/4/8/16/32 and compare recurrent versus chunk. Keep weights, beam and scoring fixed."
  },
  "native_backend": {
    "proposed_contract": [
      "prefill exact context -> immutable state handle",
      "fork parent handle into logical sequence IDs",
      "advance a frontier batch with per-sequence positions and tokens",
      "gather requested token logprobs using full vocabulary normalization before grammar mask",
      "drop pruned sequence IDs",
      "score canonical context+candidate paths independently"
    ],
    "llama_cpp": "llama_batch carries per-token positions and sequence IDs, seq_cp/rm manage branches, and get_logits_ith exposes unsampled logits. Same unified-stream Llama KV prefix copies update cell metadata without copying KV buffers.",
    "hybrid_caveat": "llama.cpp recurrent seq_cp shares tail metadata initially, but later branch materialization/state ownership must still be validated. Hybrid batches use equal sequence splitting, and recurrent rollback is bounded by n_rs_seq and restricted for shared cells; do not assume unrestricted KV-style rollback.",
    "migration_order": "MiniCPM floating-point GGUF first, preserving FSA, token bytes, context healing, search budgets and canonical final score. Verify token ID/byte mapping and probability semantics before performance and before lower-bit quantization.",
    "vllm": "logprob_token_ids can expose selected IDs without full vocabulary Python/RPC output. Current Wime already gathers legal IDs on-device before tolist; the improvement to target is batching small transfers/steps, not pretending full-logit transfer is currently happening.",
    "vllm_teacher": "Prompt token-ID teacher scoring exists on the audited V2 runner, has prefix-cache policy controls, and is not exposed by the OpenAI-compatible endpoint.",
    "probability_warning": "Audited vLLM/SGLang paths mask logits for structured grammar before returned logsoftmax. raw_logprobs/temperature controls do not necessarily recover the unmasked distribution. Start without engine grammar and retain external Wime FSA, or add a pre-mask gather API.",
    "normalizer": "Requesting only legal IDs does not by itself eliminate the full vocabulary head or its normalization. Never normalize only over allowed IDs as a substitute."
  },
  "speculation_and_quantization": {
    "dspark": "Independent approximately324M/5-layer draft paired to final MiniCPM5-2B, proposing seven tokens and using selected target hidden layers; not built-in MTP. Speculative-chain acceptance is not equivalent to Wime text-progress beam pruning, and live grammar can disable folded acceptance.",
    "priority": "Only after execution and raw scoring interfaces are correct; treat as a candidate proposer initially and validate target-model scores.",
    "quantization": "Official MiniCPM5-2B-GPTQ configuration currently selects AWQ GEMM packing (4bit/group128), with metadata describing a lossless packing conversion of GPTQ weights. Choose loaders from config, not repository names. Quantized quality must be tested separately.",
    "base_control": "Base was already evaluated: old300-case exact counts were Qwen254/final253/Base249. It is not a newly discovered repair; any new-decoder Base run is a separate control."
  },
