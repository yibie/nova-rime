;;; nova-rime-edit-test.el --- Editable composition behavior -*- lexical-binding: t; -*-

(require 'ert)
(require 'nova-rime-edit)

(defconst nova-rime-edit-test--dictionary
  '(("aa" ("甲" "a" 100) ("乙" "b" 90))
    ("bb" ("丙" "c" 100) ("丁" "d" 90))
    ("b;" ("并" "k" 100))
    ("cc" ("戊" "e" 100))))

(defmacro nova-rime-edit-test--buffer (&rest body)
  "Run BODY with editable input and a portable deterministic dictionary."
  (declare (indent 0))
  `(let ((nova-rime-editable-preedit t)
         (nova-rime-candidates-updated-hook nil)
         (nova-rime-candidate-style 'list)
         (nova-rime-show-candidates t)
         (nova-rime-user-database nil)
         (nova-rime--position-keys '("abcdefghijklmnopqrstuvwxyz" . "abcdefghijklmnopqrstuvwxyz;"))
         (nova-rime-word-penalty 0.0)
         (overriding-terminal-local-map nil))
     (cl-letf (((symbol-function 'nova-rime--entries-for)
                (lambda (code) (cdr (assoc code nova-rime-edit-test--dictionary))))
               ((symbol-function 'nova-rime--prefix-entries) (lambda (_) nil))
               ((symbol-function 'nova-rime--grammar-score) (lambda (&rest _) 0.0)))
       (with-temp-buffer
         (buffer-enable-undo)
         (nova-rime-activate "nova-rime")
         (unwind-protect (progn ,@body)
           (setq buffer-read-only nil)
           (let ((inhibit-read-only t)) (nova-rime--reset)))))))

(defun nova-rime-edit-test--command (command &rest args)
  "Run COMMAND with hooks and undo boundaries, like a command-loop action."
  (let ((this-command command))
    (run-hooks 'pre-command-hook)
    (apply command args)
    (run-hooks 'post-command-hook))
  (undo-boundary))

(defun nova-rime-edit-test--type (keys)
  "Type KEYS through input-method handling and normal command hooks."
  (mapc (lambda (key)
          (let ((this-command 'self-insert-command))
            (run-hooks 'pre-command-hook)
            (when-let* ((literal (nova-rime-input-method key)))
              (insert (apply #'string literal)))
            (run-hooks 'post-command-hook))
          (undo-boundary))
        (string-to-list keys)))

(defun nova-rime-edit-test--keys (position)
  (when-let* ((unit (nova-rime-edit--unit-at position)))
    (nova-rime-edit--unit-keys unit)))

(defun nova-rime-edit-test--correction-lines ()
  (seq-filter (lambda (overlay) (stringp (overlay-get overlay 'after-string)))
              nova-rime-edit--correction-decorations))

(defun nova-rime-edit-test--correction-text ()
  (mapconcat (lambda (overlay) (or (overlay-get overlay 'after-string) ""))
             (nova-rime-edit-test--correction-lines) ""))

(defun nova-rime-edit-test--alignments (text)
  (cl-loop for i below (length text)
           for display = (get-text-property i 'display text)
           when (and (consp display) (eq (car display) 'space))
           collect (plist-get (cdr display) :align-to)))

(defun nova-rime-edit-test--visible-annotations ()
  (mapconcat
   (lambda (overlay)
     (mapconcat (lambda (property)
                  (let ((value (overlay-get overlay property)))
                    (if (stringp value) value "")))
                '(before-string after-string help-echo) " "))
   (append (when nova-rime-edit--decoration (list nova-rime-edit--decoration))
           nova-rime-edit--correction-decorations nova-rime-edit--pending-decorations
           nova-rime-edit--aux-decorations) " "))

(defun nova-rime-edit-test--aux-text ()
  (mapconcat (lambda (overlay)
               (substring-no-properties (or (overlay-get overlay 'after-string) "")))
             nova-rime-edit--aux-decorations ""))

(ert-deftest nova-rime-edit-shows-real-text-with-reading-properties ()
  (nova-rime-edit-test--buffer
    (nova-rime-edit-test--type "aabb")
    (should (equal (buffer-substring-no-properties (point-min) (point-max)) "甲丙"))
    (should (equal (mapcar #'nova-rime-edit-test--keys '(1 2)) '("aa" "bb")))
    (should (= (point) 3))
    (should (nova-rime-edit--active-p))
    (should-not (string-match-p "aabb" (buffer-string)))))

(ert-deftest nova-rime-edit-movement-and-auxiliary-preserve-following-text ()
  (nova-rime-edit-test--buffer
    (nova-rime-edit-test--type "aabb")
    (nova-rime-edit-test--command #'backward-char 1)
    (should (nova-rime-edit--active-p))
    (nova-rime-edit-test--type "B")
    (should (equal (buffer-substring-no-properties 1 3) "乙丙"))
    (should (equal (mapcar #'nova-rime-edit-test--keys '(1 2)) '("aaB" "bb")))
    (should (= (point) 2))))

