    (nova-rime-edit-test--type "aabb")
    ;; The user fixes the second position.  The model independently changes
    ;; the first position afterwards; it must not count as user feedback.
    (nova-rime--choose-span 1 2 "丁")
    (setq nova-rime--candidate-records
          (list (nova-rime--make-candidate :text "乙丁" :end 2 :score 2.0))
          nova-rime--candidates '("乙丁"))
