(ert-deftest nova-rime-edit-correction-groups-fill-earlier-gaps-using-measured-widths ()
  (let ((window (selected-window)) measured)
    (cl-letf (((symbol-function 'nova-rime-edit--display-width)
               (lambda (text measured-window)
                 (should (eq measured-window window))
                 (let ((plain (substring-no-properties text)))
                   (push plain measured)
                   ;; This font's short second item is much narrower than its
                   ;; nominal character width, so row 1 has useful free space.
                   (or (cdr (assoc plain '(("1.长项" . 8) ("2.短项" . 2)
                                          ("3.中项" . 4) ("4.回填" . 2))))
                       (ert-fail (format "Unexpected measurement: %S" plain)))))))
      (let ((rows (split-string
                   (nova-rime-edit--correction-rows
                    '((0 (1 . "长项") (2 . "短项"))
                      (6 (3 . "中项"))
                      (9 (4 . "回填")))
                    window)
                   "\n" t)))
        (should (= (length rows) 2))
        (should (string-match-p "1[.]长项" (nth 0 rows)))
        (should (string-match-p "4[.]回填" (nth 0 rows)))
        (should (equal (nova-rime-edit-test--alignments (nth 0 rows)) '(0 9)))
        (should (string-match-p "2[.]短项" (nth 1 rows)))
        (should (string-match-p "3[.]中项" (nth 1 rows)))
        (should (equal (nova-rime-edit-test--alignments (nth 1 rows)) '(0 6))))
      (dolist (text '("1.长项" "2.短项" "3.中项" "4.回填"))
        (should (member text measured))))))

(ert-deftest nova-rime-edit-escape-really-enters-evil-normal-and-resumes-editing ()
  (unless (require 'evil nil t)
    (ert-skip "Add emacs-packages/evil and emacs-packages/goto-chg to load-path"))
  (nova-rime-edit-test--buffer
    (save-window-excursion
      ;; Keyboard macros target the selected window, even inside a temp buffer.
      (switch-to-buffer (current-buffer))
      (local-set-key [f13] #'ignore)
      (evil-local-mode 1)
      (unwind-protect
          (progn
            (evil-insert-state)
            (activate-input-method "nova-rime")
            ;; The sentinel provides a command event after the IME consumes
            ;; all letters, so execute-kbd-macro does not wait for more input.
            (execute-kbd-macro (vconcat "aaBbb" [f13]))
            (should (eq evil-state 'insert))
            (should (equal (buffer-substring-no-properties 1 (point-max)) "乙丙"))
            (execute-kbd-macro [escape f13])
            (should (eq evil-state 'normal))
            (should-not (nova-rime-edit--active-p))
            (should (equal (mapcar #'nova-rime-edit-test--keys '(1 2)) '("aaB" "bb")))
            (should (equal (nova-rime-edit-test--aux-text) "B"))
            (should nova-rime-edit--pending-decorations)
            (should-not nova-rime-edit--correction-decorations)
            (execute-kbd-macro (vconcat "i" [backspace f13]))
            (should (eq evil-state 'insert))
            (should (equal (buffer-substring-no-properties 1 (point-max)) "甲丙"))
            (should-not nova-rime-edit--aux-decorations)
            (should (equal (mapcar #'nova-rime-edit-test--keys '(1 2)) '("aa" "bb"))))
        (when current-input-method (deactivate-input-method))
        (evil-local-mode -1)))))

