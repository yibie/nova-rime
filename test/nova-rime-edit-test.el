(ert-deftest nova-rime-edit-async-publication-preserves-point-mark-and-is-undoable ()
  (nova-rime-edit-test--buffer
   (let ((transient-mark-mode t))
     (nova-rime-edit-test--type "aabb")
     (nova-rime-edit-test--command #'backward-char 1)
     (set-mark 3)
     ;; An accepted model result publishes via this same display entry point.
     (setq nova-rime--candidate-records
           (list (nova-rime--make-candidate :text "乙丁" :end 2 :score 2.0))
           nova-rime--candidates '("乙丁"))
     (nova-rime--display)
     (undo-boundary)
