    (nova-rime-edit-test--type "B")
    (should (equal (buffer-substring-no-properties 1 (point-max)) "乙API42丙"))
    (should (equal (nova-rime-edit-test--keys 7) "bb"))))

;; Text typed in English mode joins the run: the Chinese on both sides is one
;; composition, the decoder hears the literal, and SPC confirms everything.
(ert-deftest nova-rime-edit-english-mode-types-literals-inside-the-run ()
  (nova-rime-edit-test--buffer
    (setq current-input-method "nova-rime")
    (nova-rime-edit-test--type "aa")
    (nova-rime-edit-test--command #'nova-rime-toggle-english)
    (nova-rime-edit-test--type "AP 4")
    (nova-rime-edit-test--command #'nova-rime-toggle-english)
    (nova-rime-edit-test--type "bb")
    (should (equal (buffer-substring-no-properties 1 (point-max)) "甲AP 4丙"))
    (should (= nova-rime-edit--start 1))
    (should (= nova-rime-edit--end 7))
    (should (equal nova-rime--input "aabb"))
    (should (equal (nova-rime-edit--literals) '((1 . "AP 4"))))
    (should (equal (nova-rime-edit--merge "乙丁") "乙AP 4丁"))
    (nova-rime-edit-test--command #'nova-rime-toggle-english)
    (nova-rime-edit-test--type "!")
    (should (equal (nova-rime-edit--literals) '((1 . "AP 4") (2 . "!"))))
    (nova-rime-edit-test--command #'nova-rime-toggle-english)
    (nova-rime-edit-test--type ",cc")
    (should (equal (buffer-substring-no-properties 1 (point-max)) "甲AP 4丙!，戊"))
    (should (equal (nova-rime-edit--literals) '((1 . "AP 4") (2 . "!，"))))
    (should (= nova-rime-edit--end 10))
    (nova-rime-edit-test--type " ")
    (should (equal (buffer-substring-no-properties 1 (point-max)) "甲AP 4丙!，戊"))
    (should-not (text-property-not-all (point-min) (point-max) 'nova-rime-edit-unit nil))))

(ert-deftest nova-rime-edit-window-counts-syllables-only ()
  (nova-rime-edit-test--buffer
    (setq current-input-method "nova-rime")
    (let ((nova-rime-edit-max-syllables 2))
      (nova-rime-edit-test--type "aa")
      (nova-rime-edit-test--command #'nova-rime-toggle-english)
      (nova-rime-edit-test--type "XYZ")
      (nova-rime-edit-test--command #'nova-rime-toggle-english)
      (nova-rime-edit-test--type "bb")
      (should (= nova-rime-edit--start 1))
      (nova-rime-edit-test--type "cc")
      ;; The window starts at a syllable, not at the literal before it.
      (should (= nova-rime-edit--start 5))
      (should (equal nova-rime--input "bbcc")))))

;; A decoded reading must survive the dictionary guess shown while the next
;; decode is pending; otherwise a character leaving the window keeps the guess.
(ert-deftest nova-rime-edit-deleting-the-last-syllable-leaves-literals-as-text ()
  (nova-rime-edit-test--buffer
    (setq current-input-method "nova-rime")
    (nova-rime-edit-test--type "aa")
    (nova-rime-edit-test--command #'nova-rime-toggle-english)
    (nova-rime-edit-test--type "X")
    (nova-rime-edit-test--command #'nova-rime-edit-delete-backward)
    (should (equal (buffer-substring-no-properties 1 (point-max)) "甲"))
    (nova-rime-edit-test--command #'backward-char)
    (nova-rime-edit-test--type "Y")
    (should (equal (buffer-substring-no-properties 1 (point-max)) "Y甲"))
    (should (equal (nova-rime-edit--literals) nil))
    (nova-rime-edit-test--command #'forward-char)
    (nova-rime-edit-test--command #'nova-rime-edit-delete-backward)
    (nova-rime-edit-test--command #'nova-rime-edit-delete-backward)
    (should (equal (buffer-substring-no-properties 1 (point-max)) "Y"))
    (should-not (nova-rime-edit--active-p))
    (should-not (text-property-not-all (point-min) (point-max) 'nova-rime-edit-unit nil))))

(ert-deftest nova-rime-edit-ordinary-insertion-deletion-and-yank-keep-untouched-readings ()
  (nova-rime-edit-test--buffer
    (nova-rime-edit-test--type "aabbcc")
    (let ((copied (buffer-substring 1 2)))
      (nova-rime-edit-test--command #'goto-char 2)
      (nova-rime-edit-test--command #'insert "X")
      (should (equal (mapcar #'nova-rime-edit-test--keys '(1 2 3 4)) '("aa" nil "bb" "cc")))
      (nova-rime-edit-test--command #'delete-region 3 4)
      (should (equal (buffer-substring-no-properties 1 (point-max)) "甲X戊"))
      (should (equal (nova-rime-edit-test--keys 3) "cc"))
      (goto-char (point-max))
      ;; `insert-for-yank' exercises the same property-carrying path as yank.
      (nova-rime-edit-test--command #'insert-for-yank copied)
      (should (equal (buffer-substring-no-properties 1 (point-max)) "甲X戊甲"))
      (should-not (nova-rime-edit--unit-at 4)))))

