      (nova-rime-deactivate)
      (run-hooks 'post-command-hook))
    (should-not (eq (key-binding (kbd "DEL")) #'nova-rime-edit-delete-backward))
    (insert "API42")
    (should (equal (nova-rime-edit-test--keys 1) "aa"))
    (should-not (nova-rime-edit--unit-at 2))
    (should-not (nova-rime-edit--unit-at 6))
