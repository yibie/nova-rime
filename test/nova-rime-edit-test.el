(ert-deftest nova-rime-edit-c-c-c-c-remains-the-major-mode-command ()
  (nova-rime-edit-test--buffer
    (let ((map (make-sparse-keymap)) (called 0))
      (define-key map (kbd "C-c C-c")
                  (lambda () (interactive) (cl-incf called)))
      (use-local-map map)
      (nova-rime-edit-test--type "aa")
      (nova-rime-edit-test--command (key-binding (kbd "C-c C-c")))
      (should (= called 1))
      (should (equal (nova-rime-edit-test--keys 1) "aa"))
      (nova-rime-edit-test--command (key-binding (kbd "<escape>")))
      (nova-rime-edit-test--command (key-binding (kbd "C-c C-c")))
      (should (= called 2))
      (should (equal (nova-rime-edit-test--keys 1) "aa")))))

(ert-deftest nova-rime-edit-pending-marks-follow-literals-deletion-undo-and-confirmation ()
  (nova-rime-edit-test--buffer
    (nova-rime-edit-test--type "aabbcc")
    (nova-rime-edit-test--command (key-binding (kbd "<escape>")))
    (nova-rime-deactivate)
    (should nova-rime-edit--pending-decorations)
    (nova-rime-edit-test--command #'goto-char 2)
    (nova-rime-edit-test--command #'insert "X")
    (should (equal (buffer-substring-no-properties 1 (point-max)) "甲X丙戊"))
    (should (= (length nova-rime-edit--pending-decorations) 2))
    (should-not (seq-some (lambda (overlay)
                           (<= (overlay-start overlay) 2 (1- (overlay-end overlay))))
                         nova-rime-edit--pending-decorations))
    (nova-rime-edit-test--command #'delete-region 3 4)
    (should (equal (buffer-substring-no-properties 1 (point-max)) "甲X戊"))
    (should (equal (sort (mapcar (lambda (overlay)
                                 (cons (overlay-start overlay) (overlay-end overlay)))
                               nova-rime-edit--pending-decorations)
                        (lambda (a b) (< (car a) (car b))))
                   '((1 . 2) (3 . 4))))
    (nova-rime-edit-test--command #'undo-only 1)
    (should (equal (buffer-substring-no-properties 1 (point-max)) "甲X丙戊"))
    (should (equal (sort (mapcar (lambda (overlay)
                                 (cons (overlay-start overlay) (overlay-end overlay)))
                               nova-rime-edit--pending-decorations)
                        (lambda (a b) (< (car a) (car b))))
                   '((1 . 2) (3 . 5))))
    (nova-rime-activate "nova-rime")
    (nova-rime-edit-test--type " ")
    (should (equal (buffer-substring-no-properties 1 (point-max)) "甲X丙戊"))
    (should-not (text-property-not-all 1 (point-max) 'nova-rime-edit-unit nil))
    (should-not nova-rime-edit--pending-decorations)))

