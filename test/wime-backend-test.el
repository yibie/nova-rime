;;; wime-backend-test.el --- Supported backend contracts -*- lexical-binding: t; -*-
(require 'ert)
(require 'wime-checkpoint)
(require 'wime-japanese)

(ert-deftest wime-backend-native-command-excludes-japanese-and-hf-weights ()
  (let ((wime-neural-program "/bin/true") (wime-neural-interpreter "/usr/bin/python3")
        (wime-neural-backend 'minicpm-native) (wime-neural-search-method 'decode)
        (wime-neural-rescorer "/tokenizer") (wime-neural-native-library "/bridge.so")
        (wime-neural-native-model "/model.gguf") (wime-database-file "/words.db")
        (wime-japanese-model-file "/kana") (wime-japanese-table-file "/table"))
    (let ((command (wime-neural--command "/conditional")))
      (should (member "minicpm-native" command))
      (should (equal (cadr (member "--native-model" command)) "/model.gguf"))
      (should-not (member "--japanese-model" command))
      (should (equal (car (last command)) "/conditional")))
    (should-error (wime-japanese-activate "wime-japanese") :type 'user-error)))

(ert-deftest wime-backend-recipes-roundtrip-and-migrate-old-hf-settings ()
  (let ((wime-neural-backend 'minicpm-native) (wime-neural-rescorer "/tokenizer")
        (wime-neural-native-library "/bridge.so") (wime-neural-native-model "/model.gguf")
        (wime-neural-model-file "/conditional") (wime-neural-search-method 'decode)
        wime-search-width wime-neural-inference-budget wime-neural-prior-weight
        wime-neural-prior-confidence wime-neural-context-anchor wime-neural-single-character
        wime-neural-seed-candidates wime-neural-rescorer-weight wime-neural-pool-width)
    (let ((recipe (list :path "/conditional" :profile (wime-checkpoint-profile))))
      (setq wime-neural-backend 'qwen-hf wime-neural-native-model nil)
      (wime-checkpoint--apply recipe)
      (should (eq wime-neural-backend 'minicpm-native))
      (should (equal wime-neural-native-model "/model.gguf")))
    (wime-checkpoint--apply '(:path "/conditional" :profile (:rescorer "/qwen" :search_method "decode")))
    (should (eq wime-neural-backend 'qwen-hf))
    (should-not wime-neural-native-library)
    (should-not wime-neural-native-model)
    (wime-checkpoint--apply '(:path "/conditional" :profile (:rescorer :null)))
    (should-not wime-neural-rescorer)))

(ert-deftest wime-backend-missing-assets-do-not-change-worker-or-selection ()
  (let ((wime-checkpoint-directory "/nonexistent/wime-test")
        (wime-neural-backend 'qwen-hf) (wime-neural--process 'previous))
    (cl-letf (((symbol-function 'wime-checkpoint-call) (lambda (&rest _) (ert-fail "Must not save")))
              ((symbol-function 'wime-checkpoint-switch) (lambda (&rest _) (ert-fail "Must not switch"))))
      (should-error (wime-neural-select-backend 'minicpm-native) :type 'user-error))
    (should (eq wime-neural-backend 'qwen-hf))
    (should (eq wime-neural--process 'previous))))

(ert-deftest wime-backend-unknown-recipe-does-not-partially-apply ()
  (let ((wime-neural-model-file "/old"))
    (should-error (wime-checkpoint--apply '(:path "/new" :profile (:backend "legacy"))))
    (should (equal wime-neural-model-file "/old"))))
