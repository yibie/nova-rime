;;; wime-backend-test.el --- Supported backend contracts -*- lexical-binding: t; -*-
(require 'ert)
(require 'wime-checkpoint)
(require 'wime-japanese)

(ert-deftest wime-backend-recipes-roundtrip-and-clear-native-assets ()
  (let ((wime-backend-model 'minicpm-native) (wime-neural-rescorer "/tokenizer")
        (wime-backend-native-library "/bridge.so") (wime-backend-native-model "/model.gguf")
        (wime-neural-model-file "/conditional") (wime-neural-search-method 'decode)
        wime-search-width wime-neural-inference-budget wime-neural-prior-weight
        wime-neural-prior-confidence wime-neural-single-character
        wime-neural-seed-candidates wime-neural-rescorer-weight wime-neural-pool-width)
    (let ((recipe (list :path "/conditional" :profile (wime-checkpoint-profile))))
      (setq wime-backend-model 'qwen-hf wime-backend-native-model nil)
      (wime-checkpoint--apply recipe)
      (should (eq wime-backend-model 'minicpm-native))
      (should (equal wime-backend-native-model "/model.gguf")))
    (wime-checkpoint--apply '(:path "/conditional" :profile (:backend "qwen-hf" :rescorer "/qwen" :search_method "decode")))
    (should (eq wime-backend-model 'qwen-hf))
    (should-not wime-backend-native-library)
    (should-not wime-backend-native-model)
    (wime-checkpoint--apply '(:path "/conditional" :profile (:backend "qwen-hf" :search_method "verify" :rescorer :null)))
    (should-not wime-neural-rescorer)))

(ert-deftest wime-backend-missing-assets-do-not-change-worker-or-selection ()
  (let ((wime-checkpoint-directory "/nonexistent/wime-test")
        (wime-backend-model 'qwen-hf) (wime-neural--process 'previous))
    (cl-letf (((symbol-function 'wime-checkpoint-call) (lambda (&rest _) (ert-fail "Must not save")))
              ((symbol-function 'wime-checkpoint-switch) (lambda (&rest _) (ert-fail "Must not switch"))))
      (should-error (wime-select-backend 'minicpm-native) :type 'user-error))
    (should (eq wime-backend-model 'qwen-hf))
    (should (eq wime-neural--process 'previous))))

(ert-deftest wime-backend-unknown-recipe-does-not-partially-apply ()
  (let ((wime-neural-model-file "/old"))
    (should-error (wime-checkpoint--apply '(:path "/new" :profile (:backend "unknown"))))
    (should-error (wime-checkpoint--apply '(:path "/new" :profile ())))
    (should-error (wime-checkpoint--apply '(:path "/new" :profile (:backend "qwen-hf" :search_method "invalid"))))
    (should (equal wime-neural-model-file "/old"))))

(ert-deftest wime-backend-verify-selection-is-independent-of-current-model ()
  (let ((wime-neural-model-file "/conditional") (wime-database-file "/words")
        (wime-neural-program "/bin/true") (wime-neural-interpreter nil)
        (wime-backend-model 'minicpm-native) (wime-neural-search-method 'decode)
        (wime-neural-rescorer "/old/tokenizer")
        (wime-backend-native-library "/old/bridge.so") (wime-backend-native-model "/old/model.gguf")
        (wime-backend--cancel-switch nil) called)
    (cl-letf (((symbol-function 'file-readable-p)
               (lambda (path) (member path '("/conditional" "/words"))))
              ((symbol-function 'wime-checkpoint-call)
               (lambda (request)
                 (should (equal (plist-get request :op) "import-model"))
                 '(:result (:id "sha" :path "/stored/conditional"))))
              ((symbol-function 'wime-checkpoint-switch)
               (lambda (recipe persist _resolve reject)
                 (setq called t)
                 (should persist)
                 (should (equal (plist-get recipe :checkpoint) "sha"))
                 (let ((settings (wime-checkpoint--settings recipe)))
                   (cl-progv (mapcar #'car settings) (mapcar #'cdr settings)
                     (should (eq wime-neural-search-method 'verify))
                     (should-not wime-backend-native-library)
                     (should-not wime-backend-native-model)
                     (should (equal (wime-neural--command wime-neural-model-file)
                                    '("/bin/true" "/stored/conditional")))))
                 (funcall reject "test startup failure")
                 #'ignore)))
      (wime-select-backend 'verify))
    (should called)
    (should-not wime-backend--cancel-switch)
    (should (eq wime-backend-model 'minicpm-native))
    (should (eq wime-neural-search-method 'decode))
    (should (equal wime-neural-rescorer "/old/tokenizer"))))

