;;; record-conditional.el --- Exercise the actual asynchronous worker path -*- lexical-binding: t; -*-
(require 'wime-neural)
(require 'json)
(set-language-environment "UTF-8")
(setq coding-system-for-read 'utf-8-unix coding-system-for-write 'utf-8-unix
      wime-database-file (getenv "WIME_DATABASE")
      wime-grammar-module (getenv "WIME_GRAMMAR_MODULE")
      wime-grammar-shared-dir (getenv "WIME_GRAMMAR")
      wime-neural-program (getenv "WIME_NEURAL_PROGRAM")
      wime-neural-model-file (getenv "WIME_NEURAL_MODEL")
      wime-neural-delay 0)
(when (getenv "WIME_SEARCH_WIDTH")
  (setq wime-search-width (string-to-number (getenv "WIME_SEARCH_WIDTH"))))
(setq wime-neural-single-character (equal (getenv "WIME_SINGLE_CHARACTER") "1"))
(setq wime-neural-interpreter (getenv "WIME_NEURAL_INTERPRETER")
      wime-neural-rescorer (getenv "WIME_RESCORER")
      wime-neural-rescorer-weight (string-to-number (or (getenv "WIME_RESCORER_WEIGHT") "1.5"))
      wime-neural-startup-timeout (string-to-number (or (getenv "WIME_STARTUP_TIMEOUT") "30")))
(unless (file-readable-p (expand-file-name "wanxiang-lts-zh-hans.gram" wime-grammar-shared-dir))
  (error "Missing octagram artifact"))
;; With WIME_TYPING_INTERVAL, keys arrive one by one that many seconds apart
;; and wall_ms is the settle time after the last key.
(defun record-conditional--type (keys interval)
  (dolist (key (string-to-list keys))
    (wime-input-method key)
    (let ((until (+ (float-time) interval)))
      (while (< (float-time) until)
        (accept-process-output wime-neural--process 0.001)))))
(let ((cases (with-temp-buffer
               (insert-file-contents (getenv "WIME_CASES"))
               (json-parse-buffer :object-type 'alist :array-type 'list))) results (count 0))
  (unwind-protect
      (progn
        (setq wime-decoding 'hybrid)
        (dolist (case cases)
          (with-temp-buffer
            (insert (alist-get 'context case))
            (let ((interval (getenv "WIME_TYPING_INTERVAL")) start
                  (cold (not (process-live-p wime-neural--process)))
                  baseline initial-search-ms)
              (if (not interval)
                  (setq wime--input (alist-get 'input case) start (float-time))
                (record-conditional--type (substring (alist-get 'input case) 0 -1)
                                          (string-to-number interval))
                (setq start (float-time))
                (wime-input-method (aref (alist-get 'input case) (1- (length (alist-get 'input case))))))
              (unless interval (wime--refresh))
              (setq baseline (car wime--candidates)
                    initial-search-ms (* 1000 (- (float-time) start)))
              (while (and (< (- (float-time) start) 20)
                          (or (memq wime-neural--timer timer-list)
                              wime-neural--busy wime-neural--pending))
                ;; A 10 ms polling interval masks the latency of a warm GPU
                ;; request. Wait on the worker, with 1 ms for the initial timer.
                (accept-process-output wime-neural--process 0.001))
              (when (or wime-neural--failed wime-neural--busy wime-neural--pending)
                (error "Conditional worker did not complete"))
              (if (and (= (length (wime--parse wime--input)) 1)
                       (not wime-neural-single-character))
                  (when wime-neural-last-latency
                    (error "Single-syllable input must retain contextual grammar ranking"))
                (unless wime-neural-last-latency (error "Conditional model was not evaluated")))
              (push `(:id ,(alist-get 'id case) :input ,wime--input
                      :gold ,(vconcat (alist-get 'gold case))
                      :baseline ,baseline :result ,(car wime--candidates)
                      :model_evaluated ,(if wime-neural-last-latency t :false)
                      :cold_start ,(if (and cold wime-neural-last-latency) t :false)
                      :initial_search_ms ,initial-search-ms
                      :last_inference_ms ,(or wime-neural-last-latency :null)
                      :wall_ms ,(* 1000 (- (float-time) start))) results)
              (when (zerop (% (cl-incf count) 200))
                (message "Recorded %d compositions" count))
              (wime--reset))))
        (with-temp-file (getenv "WIME_RECORDING")
          (insert (json-serialize (vconcat (nreverse results))))))
    (wime-neural-restart)))
