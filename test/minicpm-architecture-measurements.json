  "findings": [
    {
      "type": "observed",
      "topic": "fusion_is_not_a_pronunciation_channel",
      "text": "小模型输入包含左文、完整键码、输出目标；其分数包含语言偏好。已用checkpoint元数据确认ranking_weight=0.5、single_character_training=true、8层448维，不能视为已校准的纯读音似然。当前训练脚本的排序损失还固定结合0.1倍旧词格先验；checkpoint未记录完整ranking_objective，不能仅凭当前脚本断言历史训练的所有参数。",
      "evidence": [
        "emacs-packages/wime/neural/conditional.py:102",
        "emacs-packages/wime/neural/train-conditional.py:199",
        "emacs-packages/wime/neural/ranking.py:63"
      ]
    },
    {
      "type": "observed",
      "topic": "dropping_small_score_is_not_a_complete_solution",
      "text": "同一旧候选池里改用规范联合分词后的LM-only，Qwen开发77→82、新样本78→80；MiniCPM开发77→77、新样本76→76。相同规范评分并保留融合，Qwen开发79、新样本81；MiniCPM开发78、新样本77。结果随模型和样本改变，不支持立即采用统一的删除融合规则。"
    },
    {
      "type": "observed",
      "topic": "proposal_recall_needs_main_model",
      "text": "字符候选64独立于通用模型tokenizer，但新90条召回仅77；字典16为73，并集80；旧搜索Qwen85、MiniCPM84。字符16召回仅70，排除了4倍候选预算带来的误读。不能把主模型只限制在小模型和词典已提出的文本里。"
    },
    {
      "type": "observed",
      "topic": "small_vocabulary_is_not_legality",
      "text": "字符原型明确排除了31063个不在小模型词表中的字典字符；两套180条参考均无此类OOV。这个原型用于分离评分因素，不是完整合法性实现。未来合法字符空间必须覆盖小模型词表之外的读音。"
    },
    {
      "type": "proposed",
      "topic": "text_constraint_automaton",
      "text": "每个音节位置按读音构造允许字符集合，再与pin和aux求交。编译为UTF-8字节自动机；依据token原始字节是否能到达合法终态进行过滤，允许一个token跨多个字或多个token组成一个字。合法性不再受小模型概率、2%稀有字门槛或词表是否有单字token影响。"
    },
    {
      "type": "proposed",
      "topic": "fixed_context_tail_healing",
      "text": "回退到稳定的上下文token前缀，把回退的原始字节S固定在自动机起点：S·A1·…·An。允许车站等跨上屏边界token，只向UI返回S之后的新文本。必须验证回退窗口、原始字节转换和Qwen混合状态恢复；固定回退一token不能声称解决全部BPE情况。"
    },
    {
      "type": "proposed",
      "topic": "one_trained_main_objective",
      "text": "主模型保留生成、扩展、修订能力，并用上下文、完整键码、真实上屏切分和同键难负例训练一个最终任务目标。可先比较任务条件生成与候选偏好训练；目标确定后小模型只用于草稿、前瞻和预算分配，不再把两份完整文本分数固定相加。当前规范联合分词LM分数保留为基线，不宣称天然就是最优最终裁判。"
    },
    {
      "type": "proposed",
      "topic": "student_objective",
      "text": "小模型优化指标转向固定延迟下的正确候选召回、主模型候选保留率、剪枝失误和可校准的提前返回。保留单字/短组合训练，增加实体、罕见字和真实逐键轨迹；小模型遗漏时主模型和字典仍可补充。用户固定选择与辅助码始终是硬约束。"
    },
    {
      "type": "not_selected_for_mainline",
      "topic": "density_ratio",
      "text": "后验减源域先验再加外部先验有Bayes动机，但需要匹配训练分布的源域LM或可靠内部先验估计。把当前小模型的拼音删掉再求分数属于训练外条件，不能直接当作先验相减。可作研究对照，不作为当前主线补丁。"
    }
  ],
  "proposed_sequence": [
    {
      "step": 1,
      "work": "先重做合法性层和上屏边界处理；保持现有评分作为过渡基线。",
      "acceptance": "完整音节、半音节、pin、aux和跨字节token均不改变允许文本；生僻字没有概率硬门槛；已上屏字节严格不变。"
    },
    {
      "step": 2,
      "work": "保留主模型补候选能力，比较草稿验证与受约束直接生成；按固定预算分别测召回和最终排序。",
      "acceptance": "小模型/词典漏选时仍有恢复路径；记录同预算召回、首选、候选抖动和实际交互p95。"
    },
    {
      "step": 3,
      "work": "在训练来源中挖同键难负例，训练一个主模型任务目标，再蒸馏和校准小模型。",
      "acceptance": "按来源隔离开发和新测试；不使用本轮已观察案例调参后再次当作未见测试；短输入与实体分层报告。"
    }
  ],
  "limitations": [
    "原先七个方案在推理前冻结，未调新权重；字典合并是事后召回审计。",
    "每套90条只有30个独立来源，whole/suffix/single相关；改进数小，不能判定架构或模型总体优越。",
