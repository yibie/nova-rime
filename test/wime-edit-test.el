(ert-deftest wime-edit-pending-marks-follow-literals-deletion-undo-and-confirmation ()
  (wime-edit-test--buffer
    (wime-edit-test--type "aabbcc")
    (wime-edit-test--command (key-binding (kbd "<escape>")))
    (wime-deactivate)
    (should wime-edit--pending-decorations)
    (wime-edit-test--command #'goto-char 2)
    (wime-edit-test--command #'insert "X")
    (should (equal (buffer-substring-no-properties 1 (point-max)) "甲X丙戊"))
    (should (= (length wime-edit--pending-decorations) 2))
    (should-not (seq-some (lambda (overlay)
                           (<= (overlay-start overlay) 2 (1- (overlay-end overlay))))
                         wime-edit--pending-decorations))
    (wime-edit-test--command #'delete-region 3 4)
    (should (equal (buffer-substring-no-properties 1 (point-max)) "甲X戊"))
    (should (equal (sort (mapcar (lambda (overlay)
                                 (cons (overlay-start overlay) (overlay-end overlay)))
                               wime-edit--pending-decorations)
                        (lambda (a b) (< (car a) (car b))))
                   '((1 . 2) (3 . 4))))
    (wime-edit-test--command #'undo-only 1)
    (should (equal (buffer-substring-no-properties 1 (point-max)) "甲X丙戊"))
    (should (equal (sort (mapcar (lambda (overlay)
                                 (cons (overlay-start overlay) (overlay-end overlay)))
                               wime-edit--pending-decorations)
                        (lambda (a b) (< (car a) (car b))))
                   '((1 . 2) (3 . 5))))
    (wime-activate "wime")
    (wime-edit-test--type " ")
    (should (equal (buffer-substring-no-properties 1 (point-max)) "甲X丙戊"))
    (should-not (text-property-not-all 1 (point-max) 'wime-edit-unit nil))
    (should-not wime-edit--pending-decorations)))

