;;; wime-edit-test.el --- Editable composition behavior -*- lexical-binding: t; -*-

(require 'ert)
(require 'wime-edit)
(require 'wime-neural)

(defconst wime-edit-test--dictionary
  '(("aa" ("甲" "a" 100) ("乙" "b" 90))
    ("bb" ("丙" "c" 100) ("丁" "d" 90))
    ("b;" ("并" "k" 100))
    ("cc" ("戊" "e" 100))))

(defmacro wime-edit-test--buffer (&rest body)
  "Run BODY with editable input and a portable deterministic dictionary."
  (declare (indent 0))
  `(let ((wime-editable-preedit t)
         (wime-candidates-updated-hook nil)
         (wime-candidate-style 'list)
         (wime-show-candidates t)
         (wime-user-database nil)
         (wime--position-keys '("abcdefghijklmnopqrstuvwxyz" . "abcdefghijklmnopqrstuvwxyz;"))
         (wime-word-penalty 0.0)
         (overriding-terminal-local-map nil))
     (cl-letf (((symbol-function 'wime--entries-for)
                (lambda (code) (cdr (assoc code wime-edit-test--dictionary))))
               ((symbol-function 'wime--prefix-entries) (lambda (_) nil))
               ((symbol-function 'wime--grammar-score) (lambda (&rest _) 0.0)))
       (with-temp-buffer
         (buffer-enable-undo)
         (wime-activate "wime")
         (unwind-protect (progn ,@body)
           (setq buffer-read-only nil)
           (let ((inhibit-read-only t)) (wime--reset)))))))

(defun wime-edit-test--command (command &rest args)
  "Run COMMAND with hooks and undo boundaries, like a command-loop action."
  (let ((this-command command))
    (run-hooks 'pre-command-hook)
    (apply command args)
    (run-hooks 'post-command-hook))
  (undo-boundary))

(defun wime-edit-test--type (keys)
  "Type KEYS through input-method handling and normal command hooks."
  (mapc (lambda (key)
          (let ((this-command 'self-insert-command))
            (run-hooks 'pre-command-hook)
            (when-let* ((literal (wime-input-method key)))
              (insert (apply #'string literal)))
            (run-hooks 'post-command-hook))
          (undo-boundary))
        (string-to-list keys)))

(defun wime-edit-test--keys (position)
  (when-let* ((unit (wime-edit--unit-at position)))
    (wime-edit--unit-keys unit)))

(ert-deftest wime-edit-shows-real-text-with-reading-properties ()
  (wime-edit-test--buffer
    (wime-edit-test--type "aabb")
    (should (equal (buffer-substring-no-properties (point-min) (point-max)) "甲丙"))
    (should (equal (mapcar #'wime-edit-test--keys '(1 2)) '("aa" "bb")))
    (should (= (point) 3))
    (should (wime-edit--active-p))
    (should-not (string-match-p "aabb" (buffer-string)))))

(ert-deftest wime-edit-movement-and-auxiliary-preserve-following-text ()
  (wime-edit-test--buffer
    (wime-edit-test--type "aabb")
    (wime-edit-test--command #'backward-char 1)
    (should (wime-edit--active-p))
    (wime-edit-test--type "B")
    (should (equal (buffer-substring-no-properties 1 3) "乙丙"))
    (should (equal (mapcar #'wime-edit-test--keys '(1 2)) '("aaB" "bb")))
    (should (= (point) 2))))

(ert-deftest wime-edit-middle-insertion-recognizes-punctuation-final-keys ()
  (wime-edit-test--buffer
    (wime-edit-test--type "aabbD")
    (wime-edit-test--command #'backward-char 1)
    (wime-edit-test--type "b;")
    (should (equal (buffer-substring-no-properties 1 (point-max)) "甲并丁"))
    (should (equal (mapcar #'wime-edit-test--keys '(1 2 3)) '("aa" "b;" "bbD")))))

(ert-deftest wime-edit-incomplete-middle-key-keeps-text-and-defers-search ()
  (wime-edit-test--buffer
    (wime-edit-test--type "aabbD")
    (wime-edit-test--command #'backward-char 1)
    (let ((lookup (symbol-function 'wime--candidates)) candidate-calls)
      (cl-letf (((symbol-function 'wime--candidates)
                 (lambda (input)
                   (push input candidate-calls)
                   (funcall lookup input))))
        (wime-edit-test--type "c"))
      ;; Flattening aa,c,bbD would invent a different syllable cb.  Its
      ;; provisional key is shown in place without interpreting that string.
      (should (equal (buffer-substring-no-properties 1 (point-max)) "甲c丁"))
      (should (equal (mapcar #'wime-edit-test--keys '(1 2 3)) '("aa" "c" "bbD")))
      (should-not (member "aacbbD" candidate-calls))
      (should-not wime--candidate-records))
    (let ((wime-neural-mode t)
          (wime-neural-model-file "unused-model")
          (wime-neural-rescorer "unused-rescorer")
          (wime-neural-search-method 'decode)
          (wime-neural--failed nil)
          scheduled)
      (cl-letf (((symbol-function 'run-with-timer)
                 (lambda (_delay _repeat _function job) (setq scheduled job) nil))
                ((symbol-function 'wime--database) (lambda () nil))
                ((symbol-function 'sqlite-select) (lambda (&rest _) '(("mspy")))))
        (wime-neural--schedule)
        (should-not scheduled)
        (wime-edit-test--type "c")
        (should (equal (buffer-substring-no-properties 1 (point-max)) "甲戊丁"))
        (should (equal (mapcar #'wime-edit-test--keys '(1 2 3)) '("aa" "cc" "bbD")))
        (wime-neural--schedule)
        (should scheduled)
        (should (equal (wime-neural--job-input scheduled) "aaccbbD"))))))

(ert-deftest wime-edit-space-pauses-through-post-command ()
  (wime-edit-test--buffer
    (wime-edit-test--type "aa ")
    (should (equal (buffer-substring-no-properties 1 (point-max)) "甲"))
    (should-not (wime-edit--active-p))
    (should (equal (wime-edit-test--keys 1) "aa"))
    (should-not (eq (key-binding (kbd "DEL")) #'wime-edit-delete-backward))
    (let ((confirm (key-binding (kbd "C-c C-c"))))
      (should (commandp confirm))
      (wime-edit-test--command confirm))
    (should-not (wime-edit--unit-at 1))))

(ert-deftest wime-edit-toggle-allows-literals-and-resumes-earlier-readings ()
  (wime-edit-test--buffer
    (wime-edit-test--type "aa")
    (let ((this-command 'toggle-input-method))
      (wime-deactivate)
      (run-hooks 'post-command-hook))
    (should-not (eq (key-binding (kbd "DEL")) #'wime-edit-delete-backward))
    (insert "API42")
    (should (equal (wime-edit-test--keys 1) "aa"))
    (should-not (wime-edit--unit-at 2))
    (should-not (wime-edit--unit-at 6))
    (wime-activate "wime")
    (wime-edit-test--type "bb")
    (should (equal (buffer-substring-no-properties 1 (point-max)) "甲API42丙"))
    (wime-edit-test--command #'goto-char 2)
    (wime-edit-test--type "B")
    (should (equal (buffer-substring-no-properties 1 (point-max)) "乙API42丙"))
    (should (equal (wime-edit-test--keys 7) "bb"))))

(ert-deftest wime-edit-ordinary-insertion-deletion-and-yank-keep-untouched-readings ()
  (wime-edit-test--buffer
    (wime-edit-test--type "aabbcc")
    (let ((copied (buffer-substring 1 2)))
      (wime-edit-test--command #'goto-char 2)
      (wime-edit-test--command #'insert "X")
      (should (equal (mapcar #'wime-edit-test--keys '(1 2 3 4)) '("aa" nil "bb" "cc")))
      (wime-edit-test--command #'delete-region 3 4)
      (should (equal (buffer-substring-no-properties 1 (point-max)) "甲X戊"))
      (should (equal (wime-edit-test--keys 3) "cc"))
      (goto-char (point-max))
      ;; `insert-for-yank' exercises the same property-carrying path as yank.
      (wime-edit-test--command #'insert-for-yank copied)
      (should (equal (buffer-substring-no-properties 1 (point-max)) "甲X戊甲"))
      (should-not (wime-edit--unit-at 4)))))

(ert-deftest wime-edit-explicit-candidate-survives-movement-and-more-input ()
  (wime-edit-test--buffer
    (wime-edit-test--type "aa2")
    (should (equal (buffer-substring-no-properties 1 (point-max)) "乙"))
    (should (eq (wime-edit--unit-pin (wime-edit--unit-at 1)) ?乙))
    (wime-edit-test--type "bb")
    (should (equal (buffer-substring-no-properties 1 (point-max)) "乙丙"))
    (wime-edit-test--command #'goto-char 1)
    (wime-edit-test--command #'goto-char (point-max))
    (should (eq (wime-edit--unit-pin (wime-edit--unit-at 1)) ?乙))))

(ert-deftest wime-edit-backspace-removes-local-auxiliary-before-code ()
  (wime-edit-test--buffer
    (wime-edit-test--type "aaBbb")
    (wime-edit-test--command #'backward-char 1)
    (wime-edit-test--command #'wime-edit-delete-backward)
    (should (equal (mapcar #'wime-edit-test--keys '(1 2)) '("aa" "bb")))
    (should (equal (buffer-substring-no-properties 1 3) "甲丙"))
    (wime-edit-test--command #'wime-edit-delete-backward)
    (should (equal (mapcar #'wime-edit-test--keys '(1 2)) '("a" "bb")))
    (wime-edit-test--command #'wime-edit-delete-backward)
    (should (equal (buffer-substring-no-properties 1 (point-max)) "丙"))
    (should (equal (wime-edit-test--keys 1) "bb"))))

(ert-deftest wime-edit-undo-redo-restores-reading-and-selected-text ()
  (wime-edit-test--buffer
    (wime-edit-test--type "aa")
    (wime-edit-test--type "B")
    (should (equal (buffer-substring-no-properties 1 2) "乙"))
    (wime-edit-test--command #'undo-only 1)
    (should (equal (buffer-substring-no-properties 1 2) "甲"))
    (should (equal (wime-edit-test--keys 1) "aa"))
    (wime-edit-test--command #'undo-redo 1)
    (should (equal (buffer-substring-no-properties 1 2) "乙"))
    (should (equal (wime-edit-test--keys 1) "aaB"))))

(ert-deftest wime-edit-undo-restores-deleted-readings ()
  (wime-edit-test--buffer
    (wime-edit-test--type "aabb")
    (wime-edit-test--command #'delete-region 1 2)
    (should (equal (buffer-substring-no-properties 1 (point-max)) "丙"))
    (wime-edit-test--command #'undo-only 1)
    (should (equal (buffer-substring-no-properties 1 (point-max)) "甲丙"))
    (should (equal (mapcar #'wime-edit-test--keys '(1 2)) '("aa" "bb")))))

(ert-deftest wime-edit-movement-resumes-restored-readings-after-undo ()
  (wime-edit-test--buffer
    (wime-edit-test--type "aabb")
    (wime-edit-test--command #'delete-region 1 2)
    (wime-edit-test--command #'undo-only 1)
    (wime-edit-test--command #'goto-char 2)
    (should (wime-edit--active-p))
    (should (equal wime--input "aabb"))))

(ert-deftest wime-edit-async-publication-preserves-point-mark-and-is-undoable ()
  (wime-edit-test--buffer
    (wime-edit-test--type "aabb")
    (wime-edit-test--command #'backward-char 1)
    (set-mark 3)
    ;; An accepted model result publishes via this same display entry point.
    (setq wime--candidate-records
          (list (wime--make-candidate :text "乙丁" :end 2 :score 2.0))
          wime--candidates '("乙丁"))
    (wime--display)
    (undo-boundary)
    (should (equal (buffer-substring-no-properties 1 (point-max)) "乙丁"))
    (should (= (point) 2))
    (should (= (mark) 3))
    (should (equal (mapcar #'wime-edit-test--keys '(1 2)) '("aa" "bb")))
    (wime-edit-test--command #'undo-only 1)
    (should (equal (buffer-substring-no-properties 1 (point-max)) "甲丙"))
    (should (equal (mapcar #'wime-edit-test--keys '(1 2)) '("aa" "bb")))
    (wime-edit-test--command #'undo-redo 1)
    (should (equal (buffer-substring-no-properties 1 (point-max)) "乙丁"))
    (should (equal (mapcar #'wime-edit-test--keys '(1 2)) '("aa" "bb")))))

(ert-deftest wime-edit-grow-run-preserves-unrelated-properties ()
  (wime-edit-test--buffer
    (wime-edit-test--type "aabb")
    (let ((wime-edit--internal t))
      (put-text-property 1 2 'wime-test-owned-property 'retained))
    (wime-edit-test--type "cc")
    (should (equal (buffer-substring-no-properties 1 (point-max)) "甲丙戊"))
    (should (eq (get-text-property 1 'wime-test-owned-property) 'retained))
    (should-not (get-text-property 3 'wime-test-owned-property))))

(ert-deftest wime-edit-narrowing-limits-reconversion-and-finalization ()
  (wime-edit-test--buffer
    (wime-edit-test--type "aabb")
    (wime-edit-pause)
    (narrow-to-region 2 3)
    (goto-char (point-max))
    (wime-edit--sync)
    (should (equal wime--input "bb"))
    (wime-edit-test--type "D")
    (should (equal (buffer-substring-no-properties (point-min) (point-max)) "丁"))
    (wime-edit-finish)
    (should-not (wime-edit--unit-at 2))
    (widen)
    (should (equal (buffer-substring-no-properties 1 (point-max)) "甲丁"))
    (should (equal (wime-edit-test--keys 1) "aa"))))

(ert-deftest wime-edit-protected-and-hidden-readings-cannot-be-reconverted ()
  (dolist (property '(read-only invisible))
    (wime-edit-test--buffer
      (wime-edit-test--type "aabb")
      (wime-edit-pause)
      (let ((overlay (make-overlay 1 2)) (buffer-invisibility-spec t))
        (overlay-put overlay property t)
        (goto-char 2)
        (wime-edit--sync)
        (should (wime-edit--active-p))
        (should (>= wime-edit--start 2))
        (should (equal (buffer-substring-no-properties 1 (point-max)) "甲丙"))
        (goto-char 3)
        (wime-edit-test--type "D")
        (should (equal (buffer-substring-no-properties 1 (point-max)) "甲丁"))
        (should (equal (wime-edit-test--keys 1) "aa"))
        (delete-overlay overlay)))))

(ert-deftest wime-edit-new-protection-does-not-break-subsequent-typing ()
  (dolist (property '(read-only invisible))
    (wime-edit-test--buffer
      (wime-edit-test--type "aabb")
      (let ((overlay (make-overlay 1 2)) (buffer-invisibility-spec t))
        ;; Overlay changes do not invoke text-change hooks.  The next key must
        ;; notice that the existing selected run can no longer be rewritten.
        (overlay-put overlay property t)
        (wime-edit-test--type "cc")
        (should (equal (buffer-substring-no-properties 1 (point-max)) "甲丙戊"))
        (should (equal (mapcar #'wime-edit-test--keys '(1 2 3)) '("aa" "bb" "cc")))
        (delete-overlay overlay)))))

(ert-deftest wime-edit-return-confirms-and-invokes-normal-buffer-command ()
  (wime-edit-test--buffer
    (let ((map (make-sparse-keymap)))
      (define-key map (kbd "RET") #'newline)
      (use-local-map map))
    (wime-edit-test--type "aa")
    (should (eq (key-binding (kbd "RET")) #'wime-edit-return))
    (wime-edit-test--command #'wime-edit-return)
    (should (equal (buffer-substring-no-properties 1 (point-max)) "甲\n"))
    (should-not (wime-edit--unit-at 1))
    (should-not (wime-edit--active-p))))

(ert-deftest wime-edit-confirmation-respects-read-only-prompt ()
  (wime-edit-test--buffer
    (let ((inhibit-modification-hooks t))
      (insert (propertize "> " 'read-only t 'rear-nonsticky t)))
    (wime-edit-test--type "aa")
    (should (equal (buffer-substring-no-properties 1 (point-max)) "> 甲"))
    (wime-edit-finish)
    (should-not (wime-edit--unit-at 3))
    (should (get-text-property 1 'read-only))
    (should (equal (buffer-substring-no-properties 1 (point-max)) "> 甲"))))

(ert-deftest wime-edit-database-change-does-not-reinterpret-existing-readings ()
  (wime-edit-test--buffer
    (let ((wime-database-file "first-scheme.db"))
      (wime-edit-test--type "aa")
      (should (equal (wime-edit--unit-database (wime-edit--unit-at 1))
                     "first-scheme.db"))
      (setq wime-database-file "second-scheme.db")
      (wime-edit--sync)
      (should-not (wime-edit--active-p))
      (should-not wime-active-mode)
      (should-not wime-edit--decoration)
      (should-not wime--input)
      (should-not (wime-edit--unit-at 1))
      (wime-edit-test--type "bb")
      (should (equal (buffer-substring-no-properties 1 (point-max)) "甲丙"))
      (should (= wime-edit--start 2))
      (should (equal wime--input "bb"))
      (should (equal (wime-edit--unit-database (wime-edit--unit-at 2))
                     "second-scheme.db"))
      (wime-edit-finish)
      (should (equal (buffer-substring-no-properties 1 (point-max)) "甲丙")))))

(ert-deftest wime-edit-confirmation-learns-only-explicitly-corrected-positions ()
  (wime-edit-test--buffer
    (wime-edit-test--type "aabb")
    ;; The user fixes the second position.  The model independently changes
    ;; the first position afterwards; it must not count as user feedback.
    (wime--choose-span 1 2 "丁")
    (setq wime--candidate-records
          (list (wime--make-candidate :text "乙丁" :end 2 :score 2.0))
          wime--candidates '("乙丁"))
    (wime--display)
    (should-not (wime-edit--unit-pin (wime-edit--unit-at 1)))
    (should (eq (wime-edit--unit-pin (wime-edit--unit-at 2)) ?丁))
    (let (learned commits)
      (cl-letf (((symbol-function 'wime--user-db) (lambda () 'test-user-db))
                ((symbol-function 'sqlite-execute)
                 (lambda (database _sql values)
                   (should (eq database 'test-user-db))
                   (push values commits)))
                ((symbol-function 'wime--learn)
                 (lambda (text units baseline)
                   (push (list text units baseline) learned))))
        (wime-edit-finish))
      (should (equal learned '(("乙丁" (("aa" . "") ("bb" . "")) "乙丙"))))
      (should (= (length commits) 1))
      (should (equal (seq-subseq (car commits) 1 5) '("aabb" "aabb" "乙丁" "甲丙")))
      (should (equal (buffer-substring-no-properties 1 (point-max)) "乙丁")))))

(ert-deftest wime-edit-unmatched-code-confirmation-preserves-all-raw-keys ()
  (wime-edit-test--buffer
    (wime-edit-test--type "zz")
    (should (equal (buffer-substring-no-properties 1 (point-max)) "z"))
    (should (equal (wime-edit-test--keys 1) "zz"))
    (wime-edit-finish)
    (should (equal (buffer-substring-no-properties 1 (point-max)) "zz"))
    (should-not (text-property-not-all 1 (point-max) 'wime-edit-unit nil))))

(ert-deftest wime-edit-paused-return-confirms-before-custom-command ()
  (wime-edit-test--buffer
    (let ((map (make-sparse-keymap)) dispatched)
      (define-key map (kbd "RET")
                  (lambda ()
                    (interactive)
                    (should-not (text-property-not-all (point-min) (point-max)
                                                      'wime-edit-unit nil))
                    (setq dispatched t)
                    (insert "|sent|")))
      (use-local-map map)
      (wime-edit-test--type "aa ")
      (should-not (wime-edit--active-p))
      (should (equal (wime-edit-test--keys 1) "aa"))
      (wime-edit-test--command (key-binding (kbd "RET")))
      (should dispatched)
      (should (equal (buffer-substring-no-properties 1 (point-max)) "甲|sent|")))))

(ert-deftest wime-edit-context-excludes-preview-while-point-moves-inside-it ()
  (wime-edit-test--buffer
    (insert "此前")
    (wime-edit-test--type "aabb")
    (should (equal (wime--context) "此前"))
    (wime-edit-test--command #'backward-char 1)
    (should (equal (wime--context) "此前"))))

(provide 'wime-edit-test)
