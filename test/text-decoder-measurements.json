  "implementation": {
    "entry": "gpu-worker.py --decoder-kind text; legacy remains the default",
    "constraints": "Independent acyclic byte graph over dictionary readings, hard pins, and auxiliary codes; no conditional-model probability or vocabulary gate. Supports partial UTF-8 tokens and complete/trailing-half syllables.",
    "healing": "Rewind up to two context tokens, regenerate their exact bytes under a fixed-prefix constraint, and remove only that literal prefix from returned candidates. Preserve at least one causal prefix token for tokenizers without BOS.",
    "search": "Main LM proposes constrained token paths. Conditional model guides completed-character prefixes only. Finite per-progress beam and terminal dedup by surface; two token histories per intermediate surface.",
    "ranking": "Canonical tokenization of context plus candidate, teacher-forced main-LM score per new character. The conditional score is not part of final LM ranking. Explicit learned bonuses still apply. A same-pool fused control is recorded.",
    "prefix_cache": "LRU of two exact immutable context prefills. Recompute generated paths on independently copied and expanded cache branches; never reuse padded or mutated recurrent states. Cached next-token rows own separate bounded storage so a retained row cannot keep its discarded batch alive.",
    "fallback": "Return no candidates for incompatible pins/aux or unsupported exact context roundtrip, leaving fallback handling to the existing UI.",
    "task_training": "Not implemented in this phase."
  },
